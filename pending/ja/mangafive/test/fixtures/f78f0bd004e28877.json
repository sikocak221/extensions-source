     <img class=\"icon active\" src=\"https://cdn.manga-5.com/contents/img/icon_star-active.svg\" />\n              <span class=\"text\">ランキング</span>\n            </div>\n          </a>\n          <a class=\"is-right menu-list-row-item\" href=\"/series\">\n            <div class=\"menu-list-row-item-inner\">\n              <img class=\"icon\" src=\"https://cdn.manga-5.com/contents/img/icon_list.svg\" />\n              <img class=\"icon active\" src=\"https://cdn.manga-5.com/contents/img/icon_list-active.svg\" />\n              <span class=\"text\">作品一覧</span>\n            </div>\n          </a>\n        </div>\n      </div>\n      <!-- 新着・シリーズ-->\n      <div class=\"menu-list-wrapper\">\n        <div class=\"menu-list\">\n          <a class=\"menu-list-item\" href=\"/series\">\n            <span class=\"text\">新着作品</span>\n          </a>\n          <a class=\"menu-list-item\" href=\"/genre/%E3%82%AA%E3%83%AA%E3%82%B8%E3%83%8A%E3%83%AB%E4%BD%9C%E5%93%81\">\n            <span class=\"text\">オリジナル作品</span>\n          </a>\n          <a class=\"menu-list-item\" href=\"/genre/%E5%A6%96%E6%80%AA%E3%82%A6%E3%82%A9%E3%83%83%E3%83%81%E3%82%B7%E3%83%AA%E3%83%BC%E3%82%BA\">\n            <span class=\"text\">妖怪ウォッチシリーズ</span>\n          </a>\n          <a class=\"menu-list-item\" href=\"/genre/%E3%83%AC%E3%83%99%E3%83%AB%E3%83%95%E3%82%A1%E3%82%A4%E3%83%96%E4%BD%9C%E5%93%81\">\n            <span class=\"text\">レベルファイブ作品</span>\n          </a>\n        </div>\n      </div>\n      <!-- サポートメニュー-->\n      <div class=\"menu-list-wrapper\">\n        <div class=\"menu-list\">\n          <a class=\"menu-list-item\" href=\"/news/\">\n            <span class=\"text\">お知らせ</span>\n          </a>\n          <a class=\"menu-list-item\" href=\"/pages/help_guide\">\n            <span class=\"text\">ヘルプ/ガイド</span>\n          </a>\n        </div>\n      </div>\n    </div>\n  </div>\n</div>\n<div class=\"header-padding\"></div>\n<main class=\"main-container\">\n  <div class=\"width-container size-medium\">\n    <div class=\"comic-list-container\">\n      <div class=\"l-w-full-sp\">\n        <!-- ** 共通 **-->\n        <!-- 見出し（通常）-->\n        <div class=\"heading-normal\">\n          <h2 class=\"title\">\n            <span class=\"text\">ランキング</span>\n          </h2>\n        </div>\n      </div>\n      <div class=\"comic-list-inner\">\n        <div class=\"comic-list-wrapper\">\n          <!-- ** 共通 **-->\n          <!-- 作品一覧-->\n          <div class=\"ranking-list book-list\">\n            <!-- no-item-->\n            <div class=\"no-item-text-wrapper\">\n              <p class=\"no-item-text\">ただいま集計中です</p>\n            </div>\n                                                      <a class=\"book-list-item\" href=\"/content/00100001\">\n  <div class=\"book-list-item-inner\">\n    <div class=\"book-list-item-thum-wrapper\">\n      <ul class=\"badge-list\"><li class=\"badge ranking\">1</li>      </ul>\n      <img class=\"thum lazyload\" src=\"https://cdn.manga-5.com/contents/img/dummy-thum.png\" data-src=\"https://cdn.manga-5.com/contents/thum/00100001_kv_th.jpg\" alt=\"エンマの休日\" />\n      <img class=\"thum-keyvisual lazyload\" src=\"https://cdn.manga-5.com/contents/img/dummy-kv.png\" data-src=\"https://cdn.manga-5.com/contents/thum/00100001_kv.jpg\" alt=\"エンマの休日\" />\n    </div>\n    <div class=\"book-list-item-meta-wrapper\">\n      <div>\n        <div>\n          <h3 class=\"title\">エンマの休日</h3>\n        </div>\n        <ul class=\"author-list\">\n                      <li class=\"author\">須藤ゆみこ</li>\n                      <li class=\"author\">レベルファイブ</li>\n                  </ul>\n        <div>\n          <p class=\"description-text\">＜毎週土曜更新！＞\r\nエンマ大王と、側近のぬらりひょんが「食べ歩き」！？\r\n先代閻魔大王の残した一冊のノートを手掛かりに、人間界の様々なグルメに舌鼓！レベルファイブ完全監修の『妖怪ウォッチ』公式スピンオフ作品が登場！</p>\n        </div>\n      </div>\n    </div>\n  </div>\n</a>\n                                                      <a class=\"book-list-item\" href=\"/content/00220001\">\n  <div class=\"book-list-item-inner\">\n    <div class=\"book-list-item-thum-wrapper\">\n      <ul class=\"badge-list\"><li class=\"badge ranking\">2</li>      </ul>\n      <img class=\"thum lazyload\" src=\"https://cdn.manga-5.com/contents/img/dummy-thum.png\" data-src=\"https://cdn.manga-5.com/contents/thum/00220001_kv_th.jpg\" alt=\"ほのスト！ ～豪炎寺のひとりごと～\" />\n      <img class=\"thum-keyvisual lazyload\" src=\"https://cdn.manga-5.com/contents/img/dummy-kv.png\" data-src=\"https://cdn.manga-5.com/contents/thum/00220001_kv.jpg\" alt=\"ほのスト！ ～豪炎寺のひとりごと～\" />\n    </div>\n    <div class=\"book-list-item-meta-wrapper\">\n      <div>\n        <div>\n          <h3 class=\"title\">ほのスト！ ～豪炎寺のひとりごと～</h3>\n        </div>\n        <ul class=\"author-list\">\n                      <li class=\"author\">あさだみほ</li>\n                      <li class=\"author\">レベルファイブ</li>\n                  </ul>\n        <div>\n          <p class=\"description-text\">＜毎週日曜更新！＞\r\n『イナズマイレブン』の公式スピンオフ作品がキックオフ！\r\n「炎のエースストライカー」と呼ばれる豪炎寺修也の何気ない日常を描く、心の中エンターテインメント！いつもクールな豪炎寺が考えていることとは――！？</p>\n        </div>\n      </div>\n    </div>\n  </div>\n</a>\n                                                      <a class=\"book-list-item\" href=\"/content/00820001\">\n  <div class=\"book-list-item-inner\">\n    <div class=\"book-list-item-thum-wrapper\">\n      <ul class=\"badge-list\"><li class=\"badge ranking\">3</li>      </ul>\n      <img class=\"thum lazyload\" src=\"https://cdn.manga-5.com/contents/img/dummy-thum.png\" data-src=\"https://cdn.manga-5.com/contents/thum/00820001_kv_th.jpg\" alt=\"まんが 半妖の滅龍士（完結）\" />\n      <img class=\"thum-keyvisual lazyload\" src=\"https://cdn.manga-5.com/contents/img/dummy-kv.png\" data-src=\"https://cdn.manga-5.com/contents/thum/00820001_kv.jpg\" alt=\"まんが 半妖の滅龍士（完結）\" />\n    </div>\n    <div class=\"book-list-item-meta-wrapper\">\n      <div>\n        <div>\n          <h3 class=\"title\">まんが 半妖の滅龍士（完結）</h3>\n        </div>\n        <ul class=\"author-list\">\n                      <li class=\"author\">三越はるは</li>\n                  </ul>\n        <div>\n          <p class=\"description-text\">「滅龍士」――。それは10年に一度訪れる大厄災「死龍」を討伐できる唯一の存在！\r\n勇気の刃で運命を切り開く、選ばれし戦士たちがここに立ち上がる！\r\n『妖怪ウォッチ ぷにぷに』で屈指の人気を誇るストーリーが待望のコミカライズ！</p>\n        </div>\n      </div>\n    </div>\n  </div>\n</a>\n                                                      <a class=\"book-list-item\" href=\"/content/00520001\">\n  <div class=\"book-list-item-inner\">\n    <div class=\"book-list-item-thum-wrapper\">\n      <ul class=\"badge-list\"><li class=\"badge ranking\">4</li>      </ul>\n      <img class=\"thum lazyload\" src=\"https://cdn.manga-5.com/contents/img/dummy-thum.png\" data-src=\"https://cdn.manga-5.com/contents/thum/00520001_kv_th.jpg\" alt=\"あつまれ！ともだち妖怪（完結）\" />\n      <img class=\"thum-keyvisual lazyload\" src=\"https://cdn.manga-5.com/contents/img/dummy-kv.png\" data-src=\"https://cdn.manga-5.com/contents/thum/00520001_kv.jpg\" alt=\"あつまれ！ともだち妖怪（完結）\" />\n    </div>\n    <div class=\"book-list-item-meta-wrapper\">\n      <div>\n        <div>\n          <h3 class=\"title\">あつまれ！ともだち妖怪（完結）</h3>\n        </div>\n        <ul class=\"author-list\">\n                      <li class=\"author\">須藤ゆみこ</li>\n                      <li class=\"author\">レベルファイブ</li>\n                  </ul>\n        <div>\n          <p class=\"description-text\">「てれびくん」で連載していた「あつまれ！ともだち妖怪」が、マンガ5に再掲載！\r\nごくごく普通の小学5年生、天野ケータとたくさんのともだち妖怪が繰り広げる、ギャグ満載のショートマンガがここに参上！</p>\n        </div>\n      </div>\n    </div>\n  </div>\n</a>\n                                                      <a class=\"book-list-item\" href=\"/content/00900001\">\n  <div class=\"book-list-item-inner\">\n    <div class=\"book-list-item-thum-wrapper\">\n      <ul class=\"badge-list\"><li class=\"badge ranking\">5</li>      </ul>\n      <img class=\"thum lazyload\" src=\"https://cdn.manga-5.com/contents/img/dummy-thum.png\" data-src=\"https://cdn.manga-5.com/contents/thum/00900001_kv_th_1035x1035.jpg\" alt=\"ごえたむの採って、作って、戦って ～ファンタジーライフi プレイ日記～\" />\n      <img class=\"thum-keyvisual lazyload\" src=\"https://cdn.manga-5.com/contents/img/dummy-kv.png\" data-src=\"https://cdn.manga-5.com/contents/thum/00900001_kv_900x400.jpg\" alt=\"ごえたむの採って、作って、戦って ～ファンタジーライフi プレイ日記～\" />\n    </div>\n    <div class=\"book-list-item-meta-wrapper\">\n      <div>\n        <div>\n          <h3 class=\"title\">ごえたむの採って、作って、戦って ～ファンタジーライフi プレイ日記～</h3>\n        </div>\n        <ul class=\"author-list\">\n                      <li class=\"author\">ごえたむ</li>\n                      <li class=\"author\">レベルファイブ</li>\n                  </ul>\n        <div>\n          <p class=\"description-text\">＜毎週金曜更新！＞\r\n大人気のシリーズ最新作『ファンタジーライフｉ グルグルの竜と時をぬすむ少女』の公式プレイマンガが登場！\r\nかけだし冒険者のごえたむと一緒に、思いのままにファンタジールを遊びつくそう！</p>\n        </div>\n      </div>\n    </div>\n  </div>\n</a>\n                                                      <a class=\"book-list-item\" href=\"/content/00550001\">\n  <div class=\"book-list-item-inner\">\n    <div class=\"book-list-item-thum-wrapper\">\n      <ul class=\"badge-list\"><li class=\"badge ranking\">6</li>      </ul>\n      <img class=\"thum lazyload\" src=\"https://cdn.manga-5.com/contents/img/dummy-thum.png\" data-src=\"https://cdn.manga-5.com/contents/thum/00550001_kv_th.jpg\" alt=\"まんが ニャーサー王物語（完結）\" />\n      <img class=\"thum-keyvisual lazyload\" src=\"https://cdn.manga-5.com/contents/img/dummy-kv.png\" data-src=\"https://cdn.manga-5.com/contents/thum/00550001_kv.jpg\" alt=\"まんが ニャーサー王物語（完結）\" />\n    </div>\n    <div class=\"book-list-item-meta-wrapper\">\n      <div>\n        <div>\n          <h3 class=\"title\">まんが ニャーサー王物語（完結）</h3>\n        </div>\n        <ul class=\"author-list\">\n                      <li class=\"author\">古岸 三</li>\n                  </ul>\n        <div>\n          <p class=\"description-text\">『妖怪ウォッチ ぷにぷに』内のイベント、「ニャーサー王物語」を公式コミカライズ！\r\nひょんなことから伝説の聖剣を抜いてしまったジバニャンたちを待ち受ける運命とは…？\r\n新たなる大冒険をマンガでもゲームでも楽しもう！\r\n監修：レベルファイブ／NHN PlayArt</p>\n        </div>\n      </div>\n    </div>\n  </div>\n</a>\n                                                      <a class=\"book-list-item\" href=\"/content/00730001\">\n  <div class=\"book-list-item-inner\">\n    <div class=\"book-list-item-thum-wrapper\">\n      <ul class=\"badge-list\"><li class=\"badge ranking\">7</li>      </ul>\n      <img class=\"thum lazyload\" src=\"https://cdn.manga-5.com/contents/img/dummy-thum.png\" data-src=\"https://cdn.manga-5.com/contents/thum/00730001_kv_th.jpg\" alt=\"大丈夫倶楽部【単行本】\" />\n      <img class=\"thum-keyvisual lazyload\" src=\"https://cdn.manga-5.com/contents/img/dummy-kv.png\" data-src=\"https://cdn.manga-5.com/contents/thum/00730001_kv.jpg\" alt=\"大丈夫倶楽部【単行本】\" />\n    </div>\n    <div class=\"book-list-item-meta-wrapper\">\n      <div>\n        <div>\n          <h3 class=\"title\">大丈夫倶楽部【単行本】</h3>\n        </div>\n        <ul class=\"author-list\">\n                      <li class=\"author\">井上まい</li>\n                  </ul>\n        <div>\n          <p class=\"description-text\">「大丈夫倶楽部」が電子単行本化！ 単行本でしか見られない書きおろしミニマンガも収録。\r\n\r\n大丈夫になりたい――。\r\n日々「大丈夫の研鑽（けんさん）」に励む花田もねは、ある晩、芦川（あしかわ）という謎の生物と出会う。その姿は「大丈夫ではない」ようで――。心癒されるハートフルストーリー！</p>\n        </div>\n      </div>\n    </div>\n  </div>\n</a>\n                                                      <a class=\"book-list-item\" href=\"/content/00760001\">\n  <div class=\"book-list-item-inner\">\n    <div class=\"book-list-item-thum-wrapper\">\n      <ul class=\"badge-list\"><li class=\"badge ranking\">8</li>      </ul>\n      <img class=\"thum lazyload\" src=\"https://cdn.manga-5.com/contents/img/dummy-thum.png\" data-src=\"https://cdn.manga-5.com/contents/thum/00760001_kv_th.jpg\" alt=\"レイトンブラザーズ・ミステリールーム 完全犯罪のパズル【単行本】\" />\n      <img class=\"thum-keyvisual lazyload\" src=\"https://cdn.manga-5.com/contents/img/dummy-kv.png\" data-src=\"https://cdn.manga-5.com/contents/thum/00760001_kv.jpg\" alt=\"レイトンブラザーズ・ミステリールーム 完全犯罪のパズル【単行本】\" />\n    </div>\n    <div class=\"book-list-item-meta-wrapper\">\n      <div>\n        <div>\n          <h3 class=\"title\">レイトンブラザーズ・ミステリールーム 完全犯罪のパズル【単行本】</h3>\n        </div>\n        <ul class=\"author-list\">\n                      <li class=\"author\">闇鍋テルミン</li>\n                  </ul>\n        <div>\n          <p class=\"description-text\">「レイトンブラザーズ・ミステリールーム 完全犯罪のパズル」が電子単行本化！ 単行本でしか見られない書きおろしミニマンガも収録。\r\n\r\nレベルファイブが贈る大ヒットナゾトキゲーム「レイトン」シリーズのスマホタイトル「レイトンブラザーズ・ミステリールーム」が念願のマンガ化！\r\n主人公は、なんとレイトン教授の息子！？奇妙な殺人事件の数々を、最強バディが解き明かす！</p>\n        </div>\n      </div>\n    </div>\n  </div>\n</a>\n                                                      <a class=\"book-list-item\" href=\"/content/00040001\">\n  <div class=\"book-list-item-inner\">\n    <div class=\"book-list-item-thum-wrapper\">\n      <ul class=\"badge-list\"><li class=\"badge ranking\">9</li>      </ul>\n      <img class=\"thum lazyload\" src=\"https://cdn.manga-5.com/contents/img/dummy-thum.png\" data-src=\"https://cdn.manga-5.com/contents/thum/00040001_kv_th.jpg\" alt=\"The MapMakers（完結）\" />\n      <img class=\"thum-keyvisual lazyload\" src=\"https://cdn.manga-5.com/contents/img/dummy-kv.png\" data-src=\"https://cdn.manga-5.com/contents/thum/00040001_kv.jpg\" alt=\"The MapMakers（完結）\" />\n    </div>\n    <div class=\"book-list-item-meta-wrapper\">\n      <div>\n        <div>\n          <h3 class=\"title\">The MapMakers（完結）</h3>\n        </div>\n        <ul class=\"author-list\">\n                      <li class=\"author\">小森陽一</li>\n                      <li class=\"author\">竹谷州史</li>\n                  </ul>\n        <div>\n          <p class=\"description-text\">「マップメーカー」、それは惑星を調査して宇宙を切り拓く、誇り高き選ばれた者たち！ \r\n一流のマップメーカーであるウェッジウッドは、ある事件に愛する家族が巻き込まれ、それまでの日常が一変する…。ＳＦアクション大作、開幕！！</p>\n        </div>\n      </div>\n    </div>\n  </div>\n</a>\n                                                      <a class=\"book-list-item\" href=\"/content/00610001\">\n  <div class=\"book-list-item-inner\">\n    <div class=\"book-list-item-thum-wrapper\">\n      <ul class=\"badge-list\"><li class=\"badge ranking\">10</li>      </ul>\n      <img class=\"thum lazyload\" src=\"https://cdn.manga-5.com/contents/img/dummy-thum.png\" data-src=\"https://cdn.manga-5.com/contents/thum/00610001_kv_th.jpg\" alt=\"レイトンブラザーズ・ミステリールーム 完全犯罪のパズル（完結）\" />\n      <img class=\"thum-keyvisual lazyload\" src=\"https://cdn.manga-5.com/contents/img/dummy-kv.png\" data-src=\"https://cdn.manga-5.com/contents/thum/00610001_kv.jpg\" alt=\"レイトンブラザーズ・ミステリールーム 完全犯罪のパズル（完結）\" />\n    </div>\n    <div class=\"book-list-item-meta-wrapper\">\n      <div>\n        <div>\n          <h3 class=\"title\">レイトンブラザーズ・ミステリールーム 完全犯罪のパズル（完結）</h3>\n        </div>\n        <ul class=\"author-list\">\n                      <li class=\"author\">闇鍋テルミン</li>\n                      <li class=\"author\">レベルファイブ</li>\n                  </ul>\n        <div>\n          <p class=\"description-text\">レベルファイブが贈る大ヒットナゾトキゲーム「レイトン」シリーズのスマホタイトル「レイトンブラザーズ・ミステリールーム」が念願のマンガ化！\r\n主人公は、なんとレイトン教授の息子！？奇妙な殺人事件の数々を、最強バディが解き明かす！</p>\n        </div>\n      </div>\n    </div>\n  </div>\n</a>\n                      </div>\n        </div>\n      </div>\n    </div>\n  </div>\n</main>\n \n<!-- パンくず-->\n<div class=\"breadcrumb-container\">\n  <div class=\"breadcrumb-wrapper width-container\">\n    <ul class=\"breadcrumb\">\n      <li class=\"breadcrumb-item\">\n        <a class=\"breadcrumb-link\" href=\"/\">TOP</a>\n      </li>\n              <li class=\"breadcrumb-item\">\n          <a class=\"breadcrumb-link\" href=\"../series\">シリーズ</a>\n        </li>\n                    <li class=\"breadcrumb-item\">\n          <a class=\"breadcrumb-link\" href=\"/ranking\">ランキング</a>\n        </li>\n          </ul>\n  </div>\n</div>\n<!-- Ad(PC/SP)-->\n<div class=\"ad-container\">\n  <div class=\"ad-banner-list\">\n    <div class=\"ad-banner-list-item\">\n        <script async src=\"https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-7972643804422549\"\n             crossorigin=\"anonymous\"></script>\n        <!-- footer -->\n        <ins class=\"adsbygoogle\"\n        